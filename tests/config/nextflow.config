// Every memory param set as a STRING, which is the whole point of this test.
//
// A Seqera launch sends params as JSON, and JSON has no MemoryUnit, so these arrive as '4 GB'
// rather than 4.GB -- and `-params-file` takes precedence over the defaults in nextflow.config.
// Any closure in conf/base.config that computes with them therefore sees a String, and must coerce
// before doing arithmetic. Do NOT "fix" this file to use 4.GB: that would make the test pass
// against the bug it exists to catch.
params {
    power_simulation_memory_floor        = '4 GB'
    power_simulation_memory_slope_per_mb = '62.5 GB'
    consolidate_memory_floor             = '4 GB'
    consolidate_memory_slope             = 24
    consolidate_memory_min               = '16 GB'
    compute_power_memory_floor           = '2 GB'
    compute_power_memory_slope           = 32
    compute_power_memory_min             = '8 GB'
    array_size                           = null
}

// The real thing, not a copy. A copy would drift.
includeConfig '../../conf/base.config'

process.executor = 'local'
