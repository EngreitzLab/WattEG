# pixi environment. pixi.toml and pixi.lock ARE tracked; the solved environment is not.
.pixi

# Nextflow
work/
.nextflow/
.nextflow.log*
report.html*
timeline.html*
trace.txt*
dag.html*

# Pipeline inputs and outputs. Input sceptre objects are hundreds of MB and must never be
# committed -- the pre-commit hook enforces a 512 KB ceiling as a backstop.
results/
prepared/
*.rds

# Debug workspaces written by the old Snakemake scripts (save.image()). No longer produced.
RDA_objects/

# Cluster job logs. Every sbatch script in workflow/slurm_executor/ writes here, and the old
# Snakemake master job wrote MB-scale .err files.
logs/

# Snakemake's own state directory, including its per-rule conda environments. Left behind by runs
# of the pre-refactor pipeline.
.snakemake/

# Leftovers from the pre-refactor pipeline and from working on the cluster: the old Snakemake
# submitter, a hand-kept backup of results/, conda environment dumps of the `base-nnfc` env that
# drove it, and an empty file created by a stray redirect.
submit_snakemake_job.sh
submit_snakemake_job.sh.bak
results_bak/
base-nnfc.*.yml
/bash

# R
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Ruserdata
.Renviron
.Rproj.user/
*-Ex.R
/*.tar.gz
/*.Rcheck/
*_cache/
/cache/
*.utf8.md
*.knit.md

# Jekyll build output for the GitHub Pages site. NOTE: docs/ itself is tracked -- the R
# template's blanket `docs/` ignore (for pkgdown) has been removed, because docs/ is the
# published documentation source.
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
.bundle/
vendor/

# OS / editor
.DS_Store
*.swp
*~

# Vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Backup written by workflow/slurm_executor/00b_relock_env.sbatch before it re-solves the lock.
# The committed pixi.lock is the record; this is only a local undo for a bad solve.
pixi.lock.before-relock

# Generated by src/make_test_data.R -- rebuilt on demand, and over the pre-commit size limit.
tests/data/
