// Sherlock profile: SLURM executor plus the container/pixi environment.
//
// WHY EVERYTHING RUNS IN A CONTAINER
//
// Sherlock is CentOS 7 (glibc 2.17) on every node, login and compute alike. conda-forge dropped
// glibc 2.17 support after CentOS 7 reached end of life, so the r-base 4.4 builds this project pins
// require glibc >= 2.28 and pixi refuses to install them. glibc is a *virtual* package -- conda
// packages link against the host C library through the system loader -- so no userspace version
// manager can supply a newer one. The Ubuntu 22.04 container (glibc 2.35) does.
//
// This mirrors workflow/slurm_executor/config.sh exactly, deliberately. The two runners must agree
// about what environment a step runs in, or a discrepancy between them becomes unattributable.

// The "Dir" suffixes are load-bearing, not style. `scratch` is a Nextflow *process directive*, and
// process.scratch is set to false below; a local `def scratch` is shadowed by it inside the config
// closures, so "--bind ${scratch}:${scratch}" expanded to "--bind false:false" and apptainer died
// with "unable to add false to mount list: destination must be an absolute path". Do not rename
// these to match the environment variables they read.
def groupHomeDir = System.getenv('GROUP_HOME')
def scratchDir   = System.getenv('SCRATCH')

params {
    pixi_bin        = params.pixi_bin        ?: "${groupHomeDir}/software/pixi/bin"
    container_image = params.container_image ?: "${groupHomeDir}/software/containers/ubuntu2204.sif"
}

process {
    executor      = 'slurm'
    queue         = 'engreitz,owners'
    container     = params.container_image
    scratch       = false
    clusterOptions = ''
}

// Submit the two fan-out steps as job arrays: one sbatch call per 100 tasks.
//
// Set as a PARAM, consumed by the `array` directive inside each process's own withName block in
// conf/base.config, rather than as a second withName block here. That is not a style choice --
// Nextflow's withName selectors across separate config files REPLACE each other, they do not deep
// merge. Declaring `withName: FIT_NULL_MODELS { array = 100 }` here silently discarded
// base.config's `memory` and `time` for that process, dropping it to the bare `process` defaults
// of 4 GB / 1 h. FIT_NULL_MODELS needs ~7.6 GB, so 788 tasks were OOM-killed and both the day2 and
// day4 sweeps died (jobs 41859217/41859218, 2026-09-03).
//
// The param defaults to null in nextflow.config, which leaves `array` unset, so non-SLURM profiles
// are unaffected -- the local executor rejects arrays outright ("Executor 'local' does not support
// job arrays"), which would otherwise break -profile stub and -profile local.
//
// VERIFY A CHANGE HERE WITH `nextflow config . -profile sherlock`, not with a stub run. The stub
// profile does not include this file, so it cannot exercise the merge that broke above.
params {
    array_size = 100
}

// WHY ARRAYS AT ALL:
    //
    // SHERLOCK CAPS JOB SUBMISSIONS PER HOUR, through its own submit plugin:
    //
    //   sbatch: error: Reached jobs per hour limit
    //   sbatch: error: Batch job submission failed: Job violates accounting/QOS policy
    //
    // It is not in `sacctmgr show qos` output and not in the Sherlock docs, so it is invisible
    // until hit, and it is a DIFFERENT limit from the owners QOS cap of 3,000 *concurrently
    // submitted* jobs that queueSize below is sized against. Measured: job 38978285 (one dataset,
    // one effect size) needed 1,130 submissions for the whole pipeline and peaked at 1,004 in one
    // hour and went through; the 2026-09-02 paper sweep needed 18,300 and was refused after 1,302
    // in one hour. So the ceiling sits just above 1,000/hour and the validated single-dataset run
    // had been sitting just under it all along.
    //
    // Arrays take an 18,300-submission sweep to ~190, which is two orders of magnitude under the
    // limit rather than negotiating with it. SLURM has supported them since Nextflow 24.04;
    // `scontrol show config` reports MaxArraySize 1000000, so the batch size is ours to choose,
    // and 100 is chosen against queueSize below so there are never many arrays outstanding.
    //
    // Array members must agree on cpus, memory, queue and time. They do on the first attempt,
    // since `N.GB * task.attempt` is N.GB for every task while task.attempt is 1, and a RETRIED
    // task is submitted individually rather than in an array by design, so the per-attempt
    // resource scaling in conf/base.config still works.

executor {
    name            = 'slurm'
    // Sherlock's owners QOS caps submitted jobs per user at 3,000, and array tasks count
    // individually. Nextflow submits one job per task, so the same ceiling applies; 900 leaves
    // room for interactive work alongside a 1,000-split run. Running N sweeps at once needs this
    // divided by N -- see conf/paper_sweep.config.
    queueSize       = 900
    submitRateLimit = '30/1min'

    // Make a refused submission recoverable rather than fatal.
    //
    // `retry.reason` is a regex matched against the submit error text, and it defaults to
    // `Socket timed out` ONLY -- so the per-hour rejection above was never classified as
    // retryable. Nextflow failed the task outright, cancelled the run, and then spent 1.5 hours
    // draining 800 pending tasks before exiting. All three sweeps died within 17 minutes of each
    // other on 2026-09-02 for this reason.
    //
    // Note this is a separate mechanism from process.errorStrategy in conf/base.config, which
    // handles a task that RAN and exited badly. A submission that was never accepted has no exit
    // status, so errorStrategy never sees it.
    //
    // With arrays in place we should never reach the limit again; this is here so that if we do,
    // the run waits instead of dying. Backing off up to 10 times at up to 15 minutes covers an
    // hour, which is the window the limit is enforced over.
    retry {
        reason      = 'Socket timed out|Reached jobs per hour limit|Job violates accounting/QOS policy'
        maxAttempts = 10
        delay       = '1 min'
        maxDelay    = '15 min'
    }
}

apptainer {
    enabled    = true
    autoMounts = true

    // autoMounts covers the work directory. These three do not come for free:
    //   * $GROUP_HOME holds the pixi binary, the environment and the container itself
    //   * $SCRATCH holds every cache, redirected there because $HOME is 15 GB and NFS-backed
    //   * a stock ubuntu:22.04 ships no ca-certificates at all, so /etc/ssl/certs does not exist
    //     and any HTTPS call dies with "No CA certificates were loaded from the system"
    runOptions = [
        "--bind ${groupHomeDir}:${groupHomeDir}",
        "--bind ${scratchDir}:${scratchDir}",
        "--bind /etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem:/etc/ssl/certs/ca-certificates.crt:ro",
        "--home ${scratchDir}/container_home"
    ].join(' ')
}

env {
    // PATH is set explicitly rather than inherited. The host's Lmod variables and R settings
    // otherwise leak into the container and can shadow the pixi environment; the failure mode is
    // an R that half-works, which is worse than one that does not start.
    PATH              = "${params.pixi_bin}:/usr/local/bin:/usr/bin:/bin"

    // Caches default to $HOME, which is 15 GB and NFS-backed. A conda-forge R stack fills a
    // meaningful fraction of it.
    PIXI_CACHE_DIR    = "${scratchDir}/pixi_cache"
    RATTLER_CACHE_DIR = "${scratchDir}/pixi_cache"
    XDG_CACHE_HOME    = "${scratchDir}/xdg_cache"

    SSL_CERT_FILE     = '/etc/ssl/certs/ca-certificates.crt'
    SSL_CERT_DIR      = '/etc/ssl/certs'
}
