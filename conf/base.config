// Resource requests, keyed by process name.
//
// These are MEASURED, not guessed. The sources are job 38887744 (the 1,000-task null_fit
// simulation array) and the sbatch scripts in workflow/slurm_executor/, which carry the same
// numbers -- see docs/status.md, "Reference numbers". Do not raise them speculatively; the whole
// point of having measured them is that a request is a claim about behaviour.
//
// cpus is 1 everywhere except POWER_SIMULATION, which runs one worker per CPU (see its block).
// The other steps are single-threaded, so more cores would idle.

process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    // Retry anything that is not exit 1.
    //
    // This used to test `task.exitStatus in [104, 134, 137, 139, 143, 247]`, which catches
    // preemption's 143 but NOT a task killed before it writes .exitcode. That one has no exit
    // status at all: Nextflow waits out executor.exitReadTimeout (270s), logs "Unable to read
    // command status", reports "terminated for an unknown reason" with `Command exit status: -`,
    // and falls through to `finish`, aborting the whole run.
    //
    // That killed the three paper sweeps on 2026-09-03 (jobs 41844187/41844191/41844194), once in
    // each run, after 2.4 hours. With 83 PREEMPTED tasks out of 2,559 completions -- 3.2 %, the
    // standing rate on the preemptible `owners` partition -- it was near-certain rather than
    // unlucky.
    //
    // Rscript exits 1 on an R error, and the line-count guard in POWER_SIMULATION also exits 1, so
    // exit 1 is the one status that means "our code is wrong, stop". Everything else -- preemption,
    // OOM, node failure, a missing exit code however Nextflow represents it -- is infrastructure,
    // and retrying costs one task. Do not narrow this back to a list of known statuses; the whole
    // failure mode was a status that is not in any list.
    errorStrategy = { task.exitStatus == 1 ? 'finish' : 'retry' }
    maxRetries    = 5

    withName: PREPARE_SIM_INPUT {
        // Peak 26.9 GB measured on the moi5 trans-discovery input; 32 GB leaves modest headroom.
        memory = { 32.GB * task.attempt }
        time   = { 1.h   * task.attempt }
    }

    withName: SPLIT_PAIRS {
        memory = { 1.GB     * task.attempt }
        time   = { 30.min   * task.attempt }
    }

    withName: POWER_SIMULATION {
        // PYTHON PATH, MEASURED 2026-09-25 on moi5 (docs/pysceptre-backend.md, "Stage B at full
        // scale"). The cost is per pair and replicate, not per task: across 20 cis tasks, 0.29 s
        // fixed per (target, replicate) call against 0.55 s per pair, and ~2 s of startup in a
        // ~2,000 s task. A 1-worker cis task peaked at 1.1-1.3 GB.
        //
        // 8 WORKERS, because the task parallelises over (target, replicate) units
        // (watteg-run-power-simulation --n-jobs); 8 workers ran 5.6x faster than 1 on a laptop,
        // byte-identical. At 1 CPU the request was 8 GB, so every task paid for an e2-standard-2
        // and used one of its two vCPUs.
        //
        // 8 GB, MEASURED: pysceptre-paper results.md, day0 (567,690 cells, 34,886 pairs) on an
        // 8-core Linux VM with the core count pinned: permutations peak 5.13 GB at 8 cores against
        // 2.46 GB at 1; the CRT 7.24 GB (10.2-10.3 GB in two earlier runs). moi5 has 131,055 cells,
        // 4.3x fewer. 4 GB is below the 8-core permutation peak, and saves nothing: no predefined
        // 8-vCPU machine has under 8 GB, and Nextflow picks the cheapest predefined shape that fits
        // (1 CPU / 8 GB ran on e2-standard-2, 1 CPU / 48 GB on e2-highmem-8). e2 vCPUs are
        // hyperthreads: 8 is 4 physical cores.
        //
        // An OOM (137) doubles the request on the retry. An infrastructure retry on gcb keeps it:
        // google.batch.maxSpotAttempts already absorbs plain preemption, so a retry Nextflow does
        // see has usually failed with a Google Batch reserved code -- 50001 (spot preemption),
        // 50002 ("VM became unresponsive", workflow 9QT0dpkW7IWgO), 50003-50005, 50006 (a VM
        // recreation) -- which says nothing about memory.
        //
        // COERCE THE PARAM. A params file carries JSON, which has no MemoryUnit, so Seqera sends
        // `power_simulation_memory` as the String '8 GB', and arithmetic on it throws while the
        // first task is being submitted (run shrivelled_bhabha, zqCjFyEUvTFEE, 2026-09-16, died
        // that way with no task record). MemoryUnit(x.toString()) accepts either form.
        cpus   = { params.power_simulation_cpus as int }
        memory = {
            def base = new nextflow.util.MemoryUnit(params.power_simulation_memory.toString())
            def infra = [50001,50002,50003,50004,50005,50006]
            def isInfraRetry = workflow.profile.tokenize(',').contains('gcb') &&
                               task.attempt > 1 && task.exitStatus in infra
            def oomRetry = task.attempt > 1 && task.exitStatus == 137
            isInfraRetry ? base : (oomRetry ? base * 2 : base)
        }
        time   = { 2.h  * task.attempt }
        array  = params.array_size
    }

    withName: CONSOLIDATE_REPLICATES {
        // Holds one effect size's rows in a data frame before writing the Parquet, so its peak is
        // a function of the input it is handed -- NOT a constant. A flat 16 GB was measured on
        // day0 (34,886 pairs x 100 simulations) and is right for it. On the moi5 trans sweep, which
        // is 21x the rows, it OOM-killed at 16 GB and again at 32 GB and only completed on the
        // third attempt at 48 GB, using 31.8 GiB (run mighty_euler, 2026-09-16). Two wasted
        // attempts and 47 minutes, for a quantity that was predictable from the staged input size.
        //
        // See params.consolidate_memory_* in nextflow.config for the calibration. asMem() coerces
        // because a params file sends these as Strings -- same reason as POWER_SIMULATION above.
        memory = {
            def staged = simulations instanceof Collection ? simulations : [simulations]
            def bytes = (staged.sum { it.size() } ?: 0L) as long
            def predicted = new nextflow.util.MemoryUnit(
                (new nextflow.util.MemoryUnit(params.consolidate_memory_floor.toString()).toBytes() +
                 params.consolidate_memory_slope * bytes) as long)
            [new nextflow.util.MemoryUnit(params.consolidate_memory_min.toString()), predicted].max() * task.attempt
        }
        time   = { 1.h   * task.attempt }
    }

    withName: COMPUTE_POWER {
        // Reads one effect size's consolidated Parquet, then splits it into one group per pair, so
        // like CONSOLIDATE_REPLICATES its peak follows the input. 8 GB was measured on day0 (2.1 GB
        // peak, 42 s, job 38978285) and is ~3.8x headroom THERE.
        //
        // At trans scale it is not close. 742,525 pairs x 100 simulations is 74,252,500 rows, which
        // needs 38.0 GiB (measured, Sherlock job 43787860) -- and the failure mode is the worst
        // available: R's allocator gives up with exit status 1, which `errorStrategy` above treats
        // as "our code is wrong, stop", so it does not retry. Run mighty_euler lost its final step
        // that way on 2026-09-16 after 6.5 hours and $136 of simulation had already succeeded, and
        // published nothing but the Parquet.
        //
        // Sizing this correctly is the fix rather than making exit 1 retryable: exit 1 genuinely
        // does mean "stop" for every other reason it can occur (an R error, the line-count guard),
        // and an allocation failure is the one case that should never have been reached.
        memory = {
            def staged = simulations instanceof Collection ? simulations : [simulations]
            def bytes = (staged.sum { it.size() } ?: 0L) as long
            def predicted = new nextflow.util.MemoryUnit(
                (new nextflow.util.MemoryUnit(params.compute_power_memory_floor.toString()).toBytes() +
                 params.compute_power_memory_slope * bytes) as long)
            [new nextflow.util.MemoryUnit(params.compute_power_memory_min.toString()), predicted].max() * task.attempt
        }
        time   = { 1.h  * task.attempt }
    }

    withName: SUMMARIZE_POWER {
        memory = { 8.GB   * task.attempt }
        time   = { 30.min * task.attempt }
    }
}
