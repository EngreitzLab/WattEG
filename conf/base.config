// Resource requests, keyed by process name.
//
// These are MEASURED, not guessed. The sources are job 38887744 (the 1,000-task null_fit
// simulation array) and the sbatch scripts in workflow/slurm_executor/, which carry the same
// numbers -- see docs/status.md, "Reference numbers". Do not raise them speculatively; the whole
// point of having measured them is that a request is a claim about behaviour.
//
// cpus is 1 everywhere on purpose: sceptre is called with parallel = FALSE and every bit of
// parallelism comes from the fan-out. Asking for more cores would idle them.

process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    // Retry anything that is not exit 1.
    //
    // This used to test `task.exitStatus in [104, 134, 137, 139, 143, 247]`, which catches
    // preemption's 143 but NOT a task killed before it writes .exitcode. That one has no exit
    // status at all: Nextflow waits out executor.exitReadTimeout (270s), logs "Unable to read
    // command status", reports "terminated for an unknown reason" with `Command exit status: -`,
    // and falls through to `finish`, aborting the whole run.
    //
    // That killed the three paper sweeps on 2026-09-03 (jobs 41844187/41844191/41844194), once in
    // each run, after 2.4 hours. With 83 PREEMPTED tasks out of 2,559 completions -- 3.2 %, the
    // standing rate on the preemptible `owners` partition -- it was near-certain rather than
    // unlucky.
    //
    // Rscript exits 1 on an R error, and the line-count guard in POWER_SIMULATION also exits 1, so
    // exit 1 is the one status that means "our code is wrong, stop". Everything else -- preemption,
    // OOM, node failure, a missing exit code however Nextflow represents it -- is infrastructure,
    // and retrying costs one task. Do not narrow this back to a list of known statuses; the whole
    // failure mode was a status that is not in any list.
    errorStrategy = { task.exitStatus == 1 ? 'finish' : 'retry' }
    maxRetries    = 5

    withName: PREPARE_SIM_INPUT {
        // Peak 7.7 GB measured; 12 GB requested, ~70 s.
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }

    withName: SPLIT_PAIRS {
        memory = { 1.GB     * task.attempt }
        time   = { 30.min   * task.attempt }
    }

    withName: FIT_NULL_MODELS {
        // ~20 min per replicate, covering every gene. Peak 7.6 GB measured, so 10 GB is only 1.3x
        // headroom -- do not lower it. Running this at the bare 4 GB default OOM-killed 788 tasks
        // on 2026-09-03; see the array_size note in conf/sherlock.config for how that happened.
        memory = { 10.GB * task.attempt }
        time   = { 2.h   * task.attempt }
        array  = params.array_size
    }

    withName: MERGE_NULL_MODELS {
        memory = { 8.GB   * task.attempt }
        time   = { 20.min * task.attempt }
    }

    withName: POWER_SIMULATION {
        // Median 36 min, max 65 min over ~6,500 tasks at 100 replicates and ~35 pairs per split
        // (jobs 38887744 and the 2026-09-03 paper sweeps). Peak RSS median 2.27 GB, max 3.27 GB.
        // Cost model: 1.140s per target + 0.5561s per pair, per replicate.
        //
        // 4 GB / 2 h, cut from 6 GB / 4 h on 2026-09-03. That is 1.2x the worst peak RSS and 1.8x
        // the worst wall clock ever observed, and the reduction is a SCHEDULING fix, not a
        // tightening for its own sake. Measured over 3,100 tasks on the same cluster in the same
        // hours:
        //
        //   | request      | median submit -> start wait |
        //   |--------------|-----------------------------|
        //   | 6 GB / 4 h   | 52.3 min  (n=2,800)         |
        //   | 4 GB / 2 h   |  4.8 min  (n=308)           |
        //
        // An 11x reduction, because both numbers were fighting the scheduler: `owners` allocates
        // 4 GB per core by default, so asking 6 GB for 1 core needs a node with spare MEMORY
        // rather than a spare core -- sh_part showed 8,347 idle cores on owners while our tasks
        // queued -- and Slurm backfills short jobs into gaps ahead of large reservations, so a 4 h
        // request is invisible to every gap under 4 h.
        //
        // The margin is thinner than it was on purpose: the errorStrategy above retries a task
        // that exceeds 4 GB, and `* task.attempt` gives it 8 GB then 12 GB. Failing 1 task in
        // 3,500 and retrying it is far cheaper than making all 18,000 queue for a 6 GB slot.
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
        array  = params.array_size
    }

    withName: COMPUTE_POWER {
        // Reads every simulation output for one effect size -- 1,000 files, 34,886 pairs x 100
        // reps -- and measured 2.1 GB peak and 42 seconds doing it (job 38978285). The 32 GB this
        // used to request was inherited from the sbatch script and never measured; it queued the
        // job behind almost everything on a shared partition for no reason. 8 GB keeps ~3.8x
        // headroom, and the input volume per task does not grow with the number of effect sizes,
        // since tasks are grouped by (sample, effect size).
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withName: SUMMARIZE_POWER {
        memory = { 8.GB   * task.attempt }
        time   = { 30.min * task.attempt }
    }
}
