// Overrides for running the three paper sweeps CONCURRENTLY.
//
//   PARAMS_FILE=config/paper_sweep_day0.yml sbatch workflow/nextflow/run.sbatch \
//       -c conf/paper_sweep.config -work-dir $SCRATCH/nextflow_work/paper_sweep_day0
//
// This file used to carry four fixes found while getting an 18,000-task sweep to run at all.
// Three of them were not specific to this sweep and have been promoted to where every run gets
// them, which is the point of having measured them:
//
//   * job arrays, and the executor.retry regex for Sherlock's per-hour submission cap
//     -> conf/sherlock.config  (SLURM-specific: the local executor rejects arrays)
//   * `errorStrategy` retrying anything that is not exit 1, for preempted tasks that never write
//     an exit code, and POWER_SIMULATION at 4 GB / 2 h instead of 6 GB / 4 h
//     -> conf/base.config  (executor-agnostic)
//
// Each carries the measurements that identified it. What is left below is the only setting that
// depends on how many sweeps share the cluster at once.

executor {
    // conf/sherlock.config sets 900, sized for ONE run against the owners QOS cap of 3,000
    // concurrently submitted jobs (`sacctmgr show qos`). Three runs at 900 would sit at 2,700 with
    // no headroom, and a submission refused at that cap is recoverable but wasteful. 800 x 3 =
    // 2,400 leaves 600 for the drivers and for interactive work.
    //
    // Array children count individually against the 3,000 cap, so arrays do not relax this one --
    // they relax the per-HOUR limit, which is a different thing.
    queueSize = 800
}

// RAISING THIS WOULD NOT HELP, AND THAT IS MEASURED, NOT ASSUMED.
//
// queueSize caps tasks IN FLIGHT (pending + running), not tasks running. On 2026-09-03, with three
// sweeps up:
//
//   | | day0 alone | all three |
//   |---|---:|---:|
//   | in flight | 1,036 | 2,507 |
//   | RUNNING   |   782 |   806 |
//
// Tripling what we asked for bought 24 more running slots. Every one of the 1,825 pending jobs gave
// reason `Priority` -- not a QOS or association limit, and `sacctmgr show assoc` shows no GrpTRES,
// MaxTRES, GrpJobs or MaxJobs on this account at all. It is fair-share: other users' jobs outrank
// ours, and the ~800 is an equilibrium rather than a ceiling (it drifted 685-806 within minutes,
// where a hard cap would pin).
//
// Two consequences worth knowing before sizing a sweep:
//
//   * Wall clock is set by ~800 concurrent slots, not by our config. 18,000 tasks x 0.63 h / 800
//     is ~14 h, and no configuration change beats that arithmetic -- the fixes in this file and in
//     conf/base.config stop runs DYING, they do not make them faster.
//   * Running N sweeps concurrently finishes no sooner than running them in sequence, since they
//     divide the same fixed allocation. It only changes which one finishes first.
//
// Fair-share priority also drops as you consume, so a long sweep gets progressively fewer slots.
// `--qos=high_p` is the documented priority lever in an owner partition and is no use here: it caps
// at 4 running jobs (`sacctmgr show qos`).
