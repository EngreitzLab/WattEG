// Overrides for running the three paper sweeps: 3 datasets x 6 effect sizes x 1,000 splits.
//
// Passed with `-c`, which takes precedence over conf/sherlock.config.
//
// WHY THIS FILE EXISTS: THE SUBMISSION LIMIT, NOT THE CONCURRENCY LIMIT
//
// The first attempt (jobs 41792735/41792737/41792750, 2026-09-02) died after 3.5 hours with
//
//   sbatch: error: Reached jobs per hour limit
//   sbatch: error: Batch job submission failed: Job violates accounting/QOS policy
//
// Sherlock enforces a cap on job submissions PER HOUR, through its own submit plugin. It is not in
// `sacctmgr show qos` output and it is not in the Sherlock docs, so it is invisible until hit. It
// is a different limit from the owners QOS cap of 3,000 *concurrently submitted* jobs, which is
// what conf/sherlock.config's queueSize is sized against and which never bound here.
//
// Measured, from sacct's own record of both runs:
//
//   * job 38978285 (2026-08-14, one dataset x one effect size, the run every measurement in
//     docs/status.md comes from) needed 1,130 submissions for the whole pipeline and peaked at
//     1,004 in one hour. It went through, roughly 25% under the ceiling.
//   * this sweep needs 18,300 submissions -- 16x more -- and 1,302 went through in the 21:00 hour
//     before the next one was refused.
//
// So the ceiling is somewhere just above 1,000/hour, and the validated single-dataset run had been
// sitting just below it all along. Nothing regressed; the workload simply got 16x bigger.

process {
    // ---- fix 1: submit job arrays, not 18,300 individual jobs --------------------------------
    //
    // One sbatch call per 100 tasks takes the sweep from 18,300 submissions to ~190, which puts it
    // two orders of magnitude under the limit instead of negotiating with it. SLURM has supported
    // this since Nextflow 24.04 and we run 25.04.7; `scontrol show config` gives MaxArraySize
    // 1000000, so the batch size is ours to choose.
    //
    // 100 is chosen against queueSize below: with 800 tasks in flight per run there are at most 8
    // arrays outstanding, so Nextflow never waits long to fill a batch.
    //
    // Array members must agree on cpus, memory, queue and time. They do on the first attempt --
    // `6.GB * task.attempt` is 6.GB for every task when task.attempt is 1 -- and a RETRIED task is
    // submitted individually rather than in an array, by design, so the per-attempt resource
    // scaling in conf/base.config still works.
    // ---- fix 4: ask for less, so we fit more nodes -------------------------------------------
    //
    // Measured on 2026-09-03: tasks ran 36 min (median) but waited **52 min** (median, p90 95 min)
    // between submit and start. The bottleneck is placement, not speed, and two of our own
    // requests were making placement harder than it needs to be:
    //
    //   * memory 6 GB against a measured median 2.27 GB / max 3.27 GB peak RSS. `owners` allocates
    //     4 GB per core by default, so asking 6 GB for 1 core means we need a node with spare
    //     MEMORY, which is scarcer than a spare core -- sh_part showed 8,347 idle cores on owners
    //     while our tasks queued.
    //   * time 4 h against a measured median 36 min / max 65 min. Slurm backfills short jobs into
    //     gaps ahead of big reservations; a 4 h request is invisible to every gap under 4 h.
    //
    // 4 GB is 1.2x the worst peak RSS ever observed over ~3,500 tasks, and 2 h is 1.8x the worst
    // wall clock. conf/base.config multiplies both by task.attempt, so a task that does blow
    // through 4 GB is retried at 8 GB and then 12 GB -- and fix 3 above is what makes that retry
    // actually happen. Failing 1 task in 3,500 and retrying it costs far less than making all
    // 18,000 queue for a 6 GB slot.
    withName: POWER_SIMULATION {
        array  = 100
        memory = { 4.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withName: FIT_NULL_MODELS  { array = 100 }

    // ---- fix 3: a preempted task with no exit code must not kill the run ---------------------
    //
    // conf/base.config retries on `task.exitStatus in [104,134,137,139,143,247]`. Preemption on
    // `owners` usually gives 143, which that list catches -- but a task killed before it writes
    // .exitcode has NO exit status at all. Nextflow waits out executor.exitReadTimeout (270s),
    // logs "Unable to read command status", reports "terminated for an unknown reason" with
    // `Command exit status: -`, and falls through to `finish`, aborting the run.
    //
    // That is what killed jobs 41844187/41844191/41844194 on 2026-09-03 -- once in each run,
    // after 2.4 hours. With 83 PREEMPTED tasks out of 2,559 completions (3.2%), at least one
    // losing its exit code was near-certain.
    //
    // Inverting the test is what fixes it: retry ANYTHING that is not a genuine script error.
    // Rscript exits 1 on an R error, and the line-count guard in the process body also exits 1,
    // so exit 1 is the one status that means "the code is wrong, stop". Everything else --
    // preemption, OOM, node failure, and a missing exit code, whether Nextflow reports it as null
    // or as Integer.MAX_VALUE -- is infrastructure, and retrying costs one task.
    errorStrategy = { task.exitStatus == 1 ? 'finish' : 'retry' }
    maxRetries    = 5
}

executor {
    // conf/sherlock.config sets 900, sized for ONE run against the 3,000 concurrent cap. Three
    // runs at 900 would sit at 2,700 with no headroom; 800 x 3 = 2,400 leaves 600 for the drivers
    // and for interactive work. Array children count individually against that cap.
    queueSize = 800

    // ---- fix 2: make a refused submission recoverable ----------------------------------------
    //
    // This is the part that turned a throttle into a dead run. `retry.reason` is a regex matched
    // against the submit error text and defaults to `Socket timed out` ONLY, so the QOS rejection
    // above was never classified as retryable: Nextflow failed the task outright, cancelled the
    // run, and then spent 1.5 hours draining 800 pending tasks before exiting. All three runs died
    // within 17 minutes of each other for this reason.
    //
    // Note this is a separate mechanism from `process.errorStrategy` in conf/base.config, which
    // handles a task that RAN and exited badly (preemption's 143, OOM's 137). A submission that was
    // never accepted has no exit status, so errorStrategy never sees it.
    //
    // With arrays in place we should never reach the limit again; this is here so that if we do,
    // the run waits instead of dying. Backing off up to 10 times at up to 15 minutes covers an
    // hour-long window, which is the period the limit is enforced over.
    retry {
        reason      = 'Socket timed out|Reached jobs per hour limit|Job violates accounting/QOS policy'
        maxAttempts = 10
        delay       = '1 min'
        maxDelay    = '15 min'
    }
}
