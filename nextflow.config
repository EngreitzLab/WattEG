// Element-gene power analysis -- Nextflow entry configuration.
//
// Run with:
//   nextflow run . -profile sherlock -params-file config/config.yml
//
// The parameters below are defaults only. config/config.yml is the documented place to set them
// and is shared with the sbatch executor in workflow/slurm_executor/, so the two runners cannot
// silently disagree about what a run means.

manifest {
    name            = 'element-gene-power-analysis'
    author          = 'Engreitz Lab'
    description     = 'Monte-Carlo power analysis for CRISPRi element-gene pairs, on top of sceptre'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    // Inputs
    samplesheet    = 'assets/samplesheet.csv'
    outdir         = 'results/nextflow'

    // Simulation
    effect_sizes   = [0.15]
    num_replicates = 100
    guide_sd       = 0.13
    seed           = 20250812

    // Parallelisation only -- results are invariant to this, since seeds derive from
    // (seed, target, rep, effect_size) rather than from the split layout.
    n_splits       = 1000

    // Replicates per simulation task. Equal to num_replicates means no chunking, which is what
    // every measured run has done. Chunking re-pays the per-target setup per chunk.
    reps_per_chunk = 100

    // Replicates per null-model task. One fit covers every gene on one replicate in ~20 minutes,
    // so 1 per task keeps the whole set at ~20 minutes rather than ~33 hours serial.
    reps_per_null_chunk = 1

    // Reporting
    power_threshold = 0.8
    conf_level      = 0.95

    // Batch size for SLURM job arrays, consumed by the `array` directive in conf/base.config.
    // Null means one job per task, which is the only thing the local executor supports -- it
    // rejects arrays outright. conf/sherlock.config sets it to 100; see the note there for why it
    // is a param rather than a second withName block.
    array_size      = null

    // Optional, unset by default. See config/config.yml.
    alpha           = null
    n_control_cells = null
    cell_batches    = null

    // Environment. The pipeline runs inside a container because Sherlock is CentOS 7 (glibc 2.17)
    // and the pinned r-base 4.4 needs glibc >= 2.28 -- see conf/sherlock.config.
    pixi_bin        = null
    container_image = null

    publish_mode    = 'copy'

    // Test-profile limits. Null in a real run; conf/test.config sets them. Declared here so a
    // typo in one of them is a missing-parameter error rather than a silently ignored setting.
    test_max_splits    = null
    test_max_null_reps = null
}

profiles {
    sherlock  { includeConfig 'conf/sherlock.config' }
    local     { process.executor = 'local' }

    // DAG validation only:
    //   nextflow run . -profile stub -params-file config/test.yml -stub-run
    // checks the channel wiring in seconds without touching the cluster. resourceLimits caps every
    // request rather than rewriting each withName block, so the measured numbers in
    // conf/base.config stay as written and the real requests are unaffected.
    stub {
        process.executor       = 'local'
        process.resourceLimits = [ memory: 2.GB, cpus: 1, time: 10.min ]
    }
}

// AFTER the profiles, deliberately. conf/base.config reads `params.array_size` for the `array`
// directive, and a plain assignment is evaluated where it is parsed -- so with the include above
// the profiles, base.config saw the null default from this file and `array` was null even under
// -profile sherlock, which sets it to 100. Parsing base.config last lets the selected profile's
// params reach it.
//
// Check with `nextflow config . -profile sherlock` after touching either file.
includeConfig 'conf/base.config'

// Provenance. Every run writes these next to the results, so a set of outputs can always be traced
// back to the code and parameters that produced it.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
