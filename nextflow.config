// Element-gene power analysis -- Nextflow entry configuration.
//
// Run with:
//   nextflow run . -profile sherlock -params-file config/config.yml
//
// The parameters below are defaults only. config/config.yml is the documented place to set them
// and is shared with the sbatch executor in workflow/slurm_executor/, so the two runners cannot
// silently disagree about what a run means.

manifest {
    name            = 'WattEG'
    author          = 'Engreitz Lab'
    description     = 'Monte-Carlo power analysis for CRISPRi element-gene pairs, on top of sceptre'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

params {
    // MEMORY THAT SCALES WITH THE INPUT, not with the dataset someone happened to calibrate on.
    //
    // Three processes hold a whole table in RAM, so their peak is a function of the input they are
    // handed rather than a property of the pipeline. Each is expressed as floor + slope x input
    // size, and every number below is measured -- the source is named per parameter. Setting them
    // as *parameters* rather than inline in conf/base.config is deliberate: a dataset far outside
    // the calibration range can be re-sized from a params file without editing the config.
    //
    // A params file may supply these as STRINGS ('4 GB'), because JSON has no MemoryUnit. The
    // closures in conf/base.config therefore coerce before doing arithmetic -- see the note there.
    // Do not assume a MemoryUnit here.

    // POWER_SIMULATION. Calibrated from 20 successful tender_mercator tasks, which peaked at
    // 4.45-5.58 GiB. A fixed-floor fit gave 44 GiB per MiB of split input; 64 GiB per MiB is a
    // conservative rounded slope because the unrounded fit under-predicted the largest task.
    power_simulation_memory_floor = 4.GB
    power_simulation_memory_slope_per_mb = 64000.MB

    // CONSOLIDATE_REPLICATES. Reads every per-split output for one effect size into one data frame
    // before writing the Parquet, so it scales with total staged input -- which is the GZIPPED
    // per-split files, not the Parquet it produces. Measured on the moi5 trans sweep (run
    // mighty_euler, 2026-09-16): 5,000 files x 371 KiB = 1.90 GB in, peak RSS 31.8 GiB, i.e. 18x.
    // 24x carries a 1.4x margin there (predicting 46.5 GiB, close to the 48 GB that finally
    // worked). The 16 GB minimum is day0's previously measured request, which this must not
    // undercut.
    consolidate_memory_floor = 4.GB
    consolidate_memory_slope = 24
    consolidate_memory_min = 16.GB

    // COMPUTE_POWER. Same shape, a steeper slope: it holds the table AND splits it into one group
    // per pair. Measured 38.0 GiB for the 1.40 GiB trans Parquet (Sherlock job 43787860), i.e.
    // ~27x, against 2.1 GB for day0's 64 MiB (job 38978285). 32x carries a ~1.2x margin at trans
    // scale. Both measurements are ~0.5 KB per simulation row, which is the underlying constant.
    compute_power_memory_floor = 2.GB
    compute_power_memory_slope = 32
    compute_power_memory_min = 8.GB

    // Inputs
    samplesheet    = 'assets/samplesheet.csv'
    outdir         = 'results/nextflow'

    // Simulation
    effect_sizes   = [0.15]
    num_replicates = 100
    guide_sd       = 0.13
    seed           = 20250812

    // Parallelisation only -- results are invariant to this, since seeds derive from
    // (seed, target, rep, effect_size) rather than from the split layout.
    n_splits       = 1000

    // Simulations per simulation task. Equal to num_replicates means no chunking, which is what
    // every measured run has done. Chunking re-pays the per-target setup per chunk.
    reps_per_chunk = 100

    // Simulations per null-model task. One fit covers every gene on one simulation in ~20 minutes,
    // so 1 per task keeps the whole set at ~20 minutes rather than ~33 hours serial.
    reps_per_null_chunk = 1

    // Reporting
    power_threshold = 0.8
    conf_level      = 0.95

    // Batch size for SLURM job arrays, consumed by the `array` directive in conf/base.config.
    // Null means one job per task, which is the only thing the local executor supports -- it
    // rejects arrays outright. conf/sherlock.config sets it to 100; see the note there for why it
    // is a param rather than a second withName block.
    array_size      = null

    // Optional, unset by default. See config/config.yml.
    alpha           = null
    n_control_cells = null
    cell_batches    = null

    // Environment. The pipeline runs inside a container because Sherlock is CentOS 7 (glibc 2.17)
    // and the pinned r-base 4.4 needs glibc >= 2.28 -- see conf/sherlock.config.
    pixi_bin        = null
    container_image = null

    publish_mode    = 'copy'

    // Test-profile limits. Null in a real run; conf/test.config sets them. Declared here so a
    // typo in one of them is a missing-parameter error rather than a silently ignored setting.
    test_max_splits    = null
    test_max_null_reps = null
}

profiles {
    sherlock  { includeConfig 'conf/sherlock.config' }
    local     { process.executor = 'local' }

    // Google Batch, launched via Seqera Platform. Needs --container_image (see conf/gcb.config
    // for why there is no default); the executor and google{}/wave{}/fusion{} settings come from
    // the Seqera compute environment, not from this profile.
    gcb       { includeConfig 'conf/gcb.config' }

    // DAG validation only:
    //   nextflow run . -profile stub -params-file config/test.yml -stub-run
    // checks the channel wiring in seconds without touching the cluster. resourceLimits caps every
    // request rather than rewriting each withName block, so the measured numbers in
    // conf/base.config stay as written and the real requests are unaffected.
    stub {
        process.executor       = 'local'
        process.resourceLimits = [ memory: 2.GB, cpus: 1, time: 10.min ]
    }
}

// AFTER the profiles, deliberately. conf/base.config reads `params.array_size` for the `array`
// directive, and a plain assignment is evaluated where it is parsed -- so with the include above
// the profiles, base.config saw the null default from this file and `array` was null even under
// -profile sherlock, which sets it to 100. Parsing base.config last lets the selected profile's
// params reach it.
//
// Check with `nextflow config . -profile sherlock` after touching either file.
includeConfig 'conf/base.config'

// Provenance. Every run writes these next to the results, so a set of outputs can always be traced
// back to the code and parameters that produced it.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
